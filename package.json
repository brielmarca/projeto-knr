{
  "name": "krz-boost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles nsis",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests *.json *.js index.html",
    "format:check": "prettier --check src tests *.json *.js index.html",
    "lint": "eslint src tests *.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.22",
    "tailwindcss": "^3.4.19",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "@tauri-apps/cli": "2.12.0",
    "vite": "^7.3.1"
  }
}
